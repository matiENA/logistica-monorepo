{
  "name": "panol-workspace",
  "version": "1.0.0",
  "description": "Monorepo Pañol Logistics - Frontend Estático & Backend Web Service desacoplados para Render y Localhost",
  "scripts": {
    "start": "node index.js",
    "build": "npm run build --prefix frontend",
    "dev": "node scripts/dev.js",
    "dev:front": "npm run dev --prefix frontend",
