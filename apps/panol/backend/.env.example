# ⚡ CONEXIÓN A SUPABASE / POSTGRESQL (rsvajuxihvmpmrmlcbul)
# DATABASE_URL=postgresql://postgres.rsvajuxihvmpmrmlcbul:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# En Supabase -> Project Settings -> Database -> Connection string (URI):
# Formato recomendado (Transaction Pooler - Port 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# O variable alternativa:
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# PG_MAX_CONNECTIONS=5
# PG_IDLE_TIMEOUT=10000
# PG_CONNECT_TIMEOUT=5000
# PG_MAX_USES=7500

